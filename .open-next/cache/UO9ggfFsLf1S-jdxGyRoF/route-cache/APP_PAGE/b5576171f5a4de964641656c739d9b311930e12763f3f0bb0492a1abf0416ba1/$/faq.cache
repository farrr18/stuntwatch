l border border-border bg-muted/70 p-1 transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\"><span class=\"sr-only\">Toggle theme</span><span class=\"inline-flex h-6 w-6 transform items-center justify-center rounded-full bg-background text-foreground shadow-sm transition-transform duration-200 translate-x-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun h-3.5 w-3.5 text-amber-500\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg></span><span aria-hidden=\"true\" class=\"pointer-events-none absolute flex w-full items-center justify-between px-1.5 text-muted-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun h-3 w-3 transition-opacity opacity-0\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon h-3 w-3 transition-opacity opacity-50\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"></path></svg></span></button></div></div></div></header><div class=\"flex-1\"><main class=\"mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8\"><a class=\"mb-6 inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted\" href=\"/maps\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left h-3.5 w-3.5\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg><span>Kembali ke Peta Nasional</span></a><div class=\"rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-sm\"><div class=\"flex items-center gap-2.5 text-rose-600 dark:text-rose-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-help h-5 w-5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path><path d=\"M12 17h.01\"></path></svg><span class=\"text-xs font-bold uppercase tracking-wider\">Dokumentasi &amp; Metodologi</span></div><h1 class=\"mt-2 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl\">Pertanyaan Umum (FAQ) &amp; Metodologi StuntWatch</h1><div class=\"mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3\"><div class=\"rounded-xl border border-border bg-muted/40 p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers h-5 w-5 text-rose-600 dark:text-rose-400\"><path d=\"m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z\"></path><path d=\"m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65\"></path><path d=\"m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65\"></path></svg><h2 class=\"mt-2 text-sm font-bold\">38 Provinsi &amp; 514 Kab/Kota</h2><p class=\"mt-1 text-xs text-muted-foreground\">Cakupan penuh kode wilayah BPS seluruh Indonesia termasuk pemekaran Papua.</p></div><div class=\"rounded-xl border border-border bg-muted/40 p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu h-5 w-5 text-amber-500\"><rect width=\"16\" height=\"16\" x=\"4\" y=\"4\" rx=\"2\"></rect><rect width=\"6\" height=\"6\" x=\"9\" y=\"9\" rx=\"1\"></rect><path d=\"M15 2v2\"></path><path d=\"M15 20v2\"></path><path d=\"M2 15h2\"></path><path d=\"M2 9h2\"></path><path d=\"M20 15h2\"></path><path d=\"M20 9h2\"></path><path d=\"M9 2v2\"></path><path d=\"M9 20v2\"></path></svg><h2 class=\"mt-2 text-sm font-bold\">SHAP Factor Decomposition</h2><p class=\"mt-1 text-xs text-muted-foreground\">Kuantifikasi faktor pendorong risiko (+) dan faktor pelindung (-) secara transparan.</p></div><div class=\"rounded-xl border border-border bg-muted/40 p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-alert h-5 w-5 text-emerald-500\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"M12 8v4\"></path><path d=\"M12 16h.01\"></path></svg><h2 class=\"mt-2 text-sm font-bold\">WCAG AA Accessible</h2><p class=\"mt-1 text-xs text-muted-foreground\">Mendukung navigasi keyboard penuh, pembaca layar, serta mode Terang dan Gelap.</p></div></div><div class=\"mt-8 space-y-4\"><div class=\"rounded-xl border border-border bg-background p-5\"><h3 class=\"text-base font-bold text-foreground\">Apa itu Indeks Risiko Stunting StuntWatch (0–100)?</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Indeks Risiko StuntWatch adalah skor komposit ternormalisasi (0 hingga 100) yang memodelkan kerentanan struktural suatu provinsi atau kabupaten/kota terhadap kejadian stunting balita. Skor 0–24 dikategorikan Rendah, 25–49 Sedang, 50–74 Tinggi, dan 75–100 Sangat Tinggi.</p></div><div class=\"rounded-xl border border-border bg-background p-5\"><h3 class=\"text-base font-bold text-foreground\">Bagaimana cara membaca Grafik Kontribusi Faktor (SHAP)?</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Grafik kontribusi faktor mengadopsi pendekatan SHapley Additive exPlanations (SHAP) dengan sumbu tengah nol (0). Batang berwarna merah yang memanjang ke kanan (+0.01 hingga +1.00) menunjukkan indikator daerah yang lebih buruk dari rata-rata nasional sehingga mendorong kenaikan risiko stunting. Sebaliknya, batang berwarna hijau ke kiri (-0.01 hingga -1.00) menunjukkan indikator yang sudah baik dan berperan sebagai faktor pelindung.</p></div><div class=\"rounded-xl border border-border bg-background p-5\"><h3 class=\"text-base font-bold text-foreground\">Apa saja 12 indikator determinan yang digunakan dalam model?</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Model menggabungkan determinan spesifik dan sensitif gizi: (1) Akses Sanitasi Layak, (2) Akses Air Minum Layak, (3) Tingkat Kemiskinan, (4) Cakupan ASI Eksklusif, (5) Prevalensi Anemia Ibu Hamil, (6) Kunjungan Antenatal Lengkap (ANC K6), (7) Imunisasi Dasar Lengkap, (8) Prevalensi BBLR, (9) Keragaman Pangan MP-ASI (MDD), (10) Pendidikan Ibu, (11) Perkawinan Usia Anak, dan (12) Ketidakcukupan Konsumsi Pangan (PoU).</p></div><div class=\"rounded-xl border border-border bg-background p-5\"><h3 class=\"text-base font-bold text-foreground\">Bagaimana arsitektur data ini dihubungkan ke API produksi nantinya?</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">StuntWatch dirancang dengan pola Mock Adapter terisolasi di direktori lib/api/mockAdapter.ts. Seluruh komponen antarmuka pengguna hanya memanggil React Query hooks (useProvinces, useKabKota, useExplanation). Saat API produksi Kemenkes/BKKBN/BPS siap, tim pengembang cukup mengganti fungsi fetch di satu berkas adapter tanpa mengubah kode komponen UI.</p></div></div></div></main><!--$--><!--/$--></div><script src=\"/_next/static/chunks/webpack-05278615a2f78772.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[14943,[\\\"114\\\",\\\"static/chunks/114-647b29bd692c1eec.js\\\",\\\"854\\\",\\\"static/chunks/854-c46a8645369c10e4.js\\\",\\\"995\\\",\\\"static/chunks/995-6b4139b43021f58a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-c5d3af01d56033e5.js\\\"],\\\"Providers\\\"]\\n3:I[16928,[\\\"114\\\",\\\"static/chunks/114-647b29bd692c1eec.js\\\",\\\"854\\\",\\\"static/chunks/854-c46a8645369c10e4.js\\\",\\\"995\\\",\\\"static/chunks/995-6b4139b43021f58a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-c5d3af01d56033e5.js\\\"],\\\"Header\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[98924,[],\\\"\\\"]\\n6:I[81959,[],\\\"ClientPageRoot\\\"]\\n7:I[85511,[\\\"114\\\",\\\"static/chunks/114-647b29bd692c1eec.js\\\",\\\"505\\\",\\\"static/chunks/app/faq/page-5c6f95fca06116ce.js\\\"],\\\"default\\\"]\\na:I[24431,[],\\\"OutletBoundary\\\"]\\nc:I[15278,[],\\\"AsyncMetadataOutlet\\\"]\\ne:I[24431,[],\\\"ViewportBoundary\\\"]\\n10:I[24431,[],\\\"MetadataBoundary\\\"]\\n11:\\\"$Sreact.suspense\\\"\\n13:I[57150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/8a30b436d5e2ce22.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"UO9ggfFsLf1S-jdxGyRoF\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"faq\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"faq\\\